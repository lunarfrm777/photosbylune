---
// Navbar.astro
import NavStyle from "./NavStyle.astro";
---

<header class="main-header" aria-label="Main navigation">
    <a href="/">
        <img src="/Logo.png" alt="Photos by Lune logo" class="logo" />
    </a>
    <NavStyle />
</header>

<style>
    * {
        box-sizing: border-box; /* makes padding/margin count inside width */
    }

    body,
    html {
        margin: 0;
        padding: 0;
        overflow-x: hidden; /* prevent horizontal scroll */
    }
    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        width: 100%;
        background: #170312;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo {
        height: 50px;
        width: auto;
        object-fit: contain;
    }


    @media screen and (max-width: 625px){
        .burger 
    }
</style>
