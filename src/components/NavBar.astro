---
import NavStyle from "./NavStyle.astro";
import MobileMenu from "./MobileMenu.astro";
---

<header class="main-header">
    <a href="/"><img src="/Logo.png" class="logo" /></a>

    <NavStyle />

    <!-- ONLY this -->
    <button id="burger-btn"><i class="checkbtn fa-solid fa-burger"></i></button>
</header>

<!-- mobile menu lives OUTSIDE -->
<MobileMenu />

<style>
    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        width: 100%;
        background: #170312;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        overflow: auto;
        position: relative;
    }
    .logo {
        height: 50px;
        width: auto;
        object-fit: contain;
    }
    .checkbtn {
        display: none;
    }

    @media screen and (max-width: 625px) {
        .checkbtn {
            display: block;
        }
    }
</style>
