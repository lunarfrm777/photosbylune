---
import NavStyle from "./NavStyle.astro";
---

<header class="main-header" aria-label="Main navigation">
    <div class="style-nav" aria-label="styling for entire navbar">
        <!-- will be updated to logo -->
        <a href="/">
          <img src="/Logo.png" alt="Photos by Lune logo" class="logo" />
        </a>
        <NavStyle />
    </div>
</header>

<style>
     .main-header {
        display: flex;
        justify-content: space-between;
        padding: 1rem 2rem;
        background: #ffa9e5f4;
        color: white;
    }

    .style-nav {
        background: rgba(0, 0, 0, 0.3);
        width: 100%;
        height
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    /* will be updated to logo */
    h1 {
        text-align:center;
        color: black;
    }

    a {
        text-decoration: none;
    }

    img{
        width: 10%;
        height: 10%;
    }
</style>
