<div class="about-contact-wrapper">
  <section id="about" class="about-contact">
    <div class="content">
      <div class="about">
        <h2>About Me</h2>
        <p>
          I’m a photographer passionate about capturing life’s beautiful
          moments.
        </p>
      </div>

      <div id="contact" class="contact">
        <h2>Contact Me</h2>
        <form>
          <input type="text" placeholder="Name" />
          <input type="email" placeholder="Email" />
          <textarea placeholder="Message"></textarea>
          <button>Send</button>
        </form>
      </div>
    </div>
  </section>
</div>
