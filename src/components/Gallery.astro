---
import PhotoCard from "../components/PhotoCard.astro";

const photos = [
  { src: "/fulls/01.jpg", alt: "Full Moon" },
  { src: "/fulls/02.jpg", alt: "Sunrise" },
  { src: "/fulls/03.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/04.jpg", alt: "Many Mountains with water line" },
  { src: "/fulls/05.jpg", alt: "3 Sisters Mountains" },
  { src: "/fulls/06.jpg", alt: "Cows grazing" },
  { src: "/fulls/07.jpg", alt: "Cows grazing" },
  { src: "/fulls/08.jpg", alt: "Bright tree in winter" },
  { src: "/fulls/09.jpg", alt: "Bright bench in snowy tree covered park" },
  { src: "/fulls/10.jpg", alt: "CN Tower close up" },
  { src: "/fulls/11.jpg", alt: "TTC Streetcar lights through heavy snowfall" },
  { src: "/fulls/12.jpg", alt: "Back of TTC Streetcar during snowfall" },
];
---

<div class="grid-gallery" id="portfolio">
  {photos.map((photo) => <PhotoCard {...photo} />)}
</div>

<style>
  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 0.2rem;
    padding: 2rem;
    background-color: aquamarine;
  }

  /* responsive */
  @media (max-width: 900px) {
    .grid-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
