    <!-- desktop links -->
    <nav class="nav-links-container">
        <ul class="nav-links">
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</header>

<style>
    :global(*) {
        box-sizing: border-box;
    }
    /* .burger {
        display: none;
        position: relative;
        height: 10px;
        width: 10px;
        background-color: white;
    } */

    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        width: 100%;
        background: #170312;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        overflow: auto;
        position: relative;
    }

    .logo {
        height: 50px;
        width: auto;
        object-fit: contain;
    }
    .nav-links-container {
        display: flex;
        align-items: center;
        gap: 2rem;
        justify-content: end;
    }

    /* nav links horizontal list */
    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* individual link style + hover underline */
    .nav-links a {
        position: relative;
        text-decoration: none;
        font-weight: bold;
        color: #f36282;
        transition: color 0.3s ease;
        font-family: "Jost", sans-serif;
        font-size: 14px;
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: rgb(255, 120, 235);
        transition: width 0.3s ease;
    }

    .nav-links a:hover {
        color: #e3eb00;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    @media screen and (max-width: 625px) {
        .nav-links-container {
            display: none;
        }
    }
</style>
