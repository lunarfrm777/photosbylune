<nav class="nav-links-container">
    <ul class="nav-links">
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</nav>

<style>
    .nav-links-container {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    /* nav links horizontal list */
    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* individual link style + hover underline */
    .nav-links a {
        position: relative;
        text-decoration: none;
        font-weight: bold;
        color: rgba(255, 255, 255, 0.7);
        transition: color 0.3s ease;
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: rgb(255, 120, 235);
        transition: width 0.3s ease;
    }

    .nav-links a:hover {
        color: white;
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    /* responsive: stack links under 768px */
    @media (max-width: 768px) {
        .nav-links {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>
