<header class="main-header">
    <a href="/"><img src="/Logo.png" alt="Logo" class="logo" /></a>

    <!-- desktop links -->
    <nav class="nav-links-container">
        <ul class="nav-links">
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- burger / mobile links -->
    <div class="burger">
        <input type="checkbox" id="check" />
        <label for="check" class="checkbtn">☰</label>
        <ul class="nav-mobile">
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </div>
</header>

<style>
    .burger {
        display: none;
        position: relative;
        height: 10px;
        width: 10px;
        background-color: white;
    }

    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        width: 100%;
        background: #170312;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        overflow-x: auto;
    }

    .logo {
        height: 50px;
        width: auto;
        object-fit: contain;
    }
    .nav-links-container {
        display: flex;
        align-items: center;
        flex-wrap: wrap; /* allows items to go to next line */
        gap: 2rem;
        justify-content: end;
    }

    /* nav links horizontal list */
    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* individual link style + hover underline */
    .nav-links a {
        position: relative;
        text-decoration: none;
        font-weight: bold;
        color: #f36282;
        transition: color 0.3s ease;
        font-family: "Jost", sans-serif;
        font-size: 14px;
    }

    .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: rgb(255, 120, 235);
        transition: width 0.3s ease;
    }

    .nav-links a:hover {
        color: #e3eb00;
    }

    .nav-links a:hover::after {
        width: 100%;
    }
    #check {
        display: none;
    }
    .checkbtn {
        font-size: 1.5rem;
        color: white;
        cursor: pointer;
        display: none;
    }

    .nav-mobile {
        display: none;
        position: absolute;
        top: 4.5rem;
        left: 0;
        background: #46124b;
        z-index: 1;
        width: 200px;
    }

    #check:checked ~ .nav-mobile {
        display: block;
    }

    #check:checked ~ .nav-mobile {
        display: block;
    }

    .nav-mobile a {
        color: #fff;
        padding: 1rem 1.5rem;
        display: block;
    }

    @media screen and (max-width: 625px) {
        .burger {
            display: block; /* shows burger on small screens */
            position: relative;
        }

        .nav-links-container {
            display: none; /* hide desktop links */
        }

        .nav-mobile {
            display: none; /* hidden by default */
            position: absolute;
            top: 100%; /* under header */
            left: 0;
            width: 100%;
            background: #46124b;
            flex-direction: column;
            z-index: 10;
        }

        #check:checked ~ .nav-mobile {
            display: flex; /* show menu when checkbox checked */
        }

        .nav-mobile li a {
            padding: 1.5rem;
            display: block;
            font-size: 1.5rem;
            color: #fff;
            text-align: center;
        }
    }
</style>
