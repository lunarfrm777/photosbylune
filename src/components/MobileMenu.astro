<!-- burger / mobile links -->
<div class="burger">
    <button id="burger-btn"><i class="fa-solid fa-burger"></i></button>

    <ul class="nav-mobile" id="nav-mobile">
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</div>
<style>
    .burger {
        display: none;
        position: relative;
    }

    .checkbtn {
        display: none;
        font-size: 2rem;
        cursor: pointer;
        color: white;
    }

    /* menu */
    .nav-mobile {
        display: none;
        padding: 2rem 0;
        position: fixed;
        top: 70px;
        left: 0;
        width: 100%;
        background: red;
        height: 200px;
        z-index: 9999;
    }

    .nav-mobile li {
        list-style-type: none;
    }
    .nav-mobile a {
        display: block;
        position: relative;
        text-decoration: none;
        padding: 1.5rem;
        font-size: 1.8rem;
        font-weight: bold;
        color: #f36282;
        transition: color 0.3s ease;
        font-family: "Jost", sans-serif;
        font-size: 14px;
    }
    .nav-mobile a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: rgb(255, 120, 235);
        transition: width 0.3s ease;
    }

    .nav-mobile a:hover {
        color: #e3eb00;
    }

    .nav-mobile a:hover::after {
        width: 100%;
    }

    /* toggle works because SAME component */
    #check:checked ~ .nav-mobile {
        display: block;
    }

    /* MOBILE */
    @media screen and (max-width: 625px) {
        .burger {
            display: block;
        }

        :global(.nav-links-container) {
            display: none; /* hide desktop links */
        }
    }
</style>
<script>
    const btn = document.getElementById("burger-btn");
    const menu = document.getElementById("nav-mobile");

    btn.addEventListener("click", () => {
        menu.style.display = menu.style.display === "block" ? "none" : "block";
    });
    menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu.style.display = "none";
        });
    });
</script>
