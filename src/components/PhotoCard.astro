---
const { src, alt } = Astro.props;
---

<div class="photo-card">
    <img src={src} alt={alt} loading="lazy" />
</div>

<style>
    .photo-card {
        display: block;
        border: 0.2rem solid black;
        /* keeps rounded corners tidy specifically when user hovers!! */
        overflow: hidden;
    }

    .photo-card img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
        transition: transform 0.3s;
    }

    .photo-card img:hover {
        transform: scale(1.05);
    }
</style>
