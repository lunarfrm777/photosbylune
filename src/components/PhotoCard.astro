---
const { image, alt, width, src } = Astro.props;
---

<div class="bordered">
    <img src={src} alt={alt} width={200} height={200} />
</div>

<style>
    .bordered {
        border: 3px white solid;
        border-radius: 0.7rem;
    }

    /* have to improve responsive for cards,, should be a set top middle and bottom so they are sliding with screen size
    rather than clicking into place */
    .photo-card {
        display: grid;
        gap: 1rem;
        background-color: rgb(183, 124, 255);
        border-radius: 0.5rem;
        text-decoration: none;
        text-align: center;
        color: black;
    }

    .photo-card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border: 0.2rem black solid;
        border-radius: 1rem;
        cursor: pointer;
        transition: transform 0.3s;
    }

    .photo-card img:hover {
        transform: scale(1.05);
    }
</style>
