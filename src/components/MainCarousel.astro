<section id="hero" class="hero">
    <div class="carousel-wrapper">
        <button
            class="arrow left"
            aria-label="Scrolling left through carousel navigation">❮</button
        >
        <!-- screen reader will focus to it with tabindex="0" -->
        <div
            class="carousel"
            tabindex="0"
            aria-label="Photography portfolio carousel"
            id="portfolio">
            <div class="carousel-item">
                <img src="/fulls/01.jpg" alt="Full Moon" loading="lazy" />
            </div>
            <div class="carousel-item">
                <img src="/fulls/02.jpg" alt="Sunrise" loading="lazy" />
            </div>
            <div class="carousel-item">
                <img src="/fulls/03.jpg" alt="Mountain peak" loading="lazy" />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/04.jpg"
                    alt="Mountains with water line"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img src="/fulls/05.jpg" alt="Cows grazing" loading="lazy" />
            </div>
            <div class="carousel-item">
                <img src="/fulls/06.jpg" alt="Cows grazing" loading="lazy" />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/07.jpg"
                    alt="Three Sisters Mountains"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/08.jpg"
                    alt="Yellow bright tree in the winter"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/09.jpg"
                    alt="Yellow bench in a snow tree covered park"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/10.jpg"
                    alt="CN Tower close up"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/11.jpg"
                    alt="TTC Streetcar lights during heavy snow"
                    loading="lazy"
                />
            </div>
            <div class="carousel-item">
                <img
                    src="/fulls/12.jpg"
                    alt="Back of TTC Streetcar during snowfall"
                    loading="lazy"
                />
            </div>
        </div>
        <button
            class="arrow right"
            aria-label="Scrolling right through carousel navigation">❯</button
        >
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const carousel = document.querySelector(".carousel");
        const leftBtn = document.querySelector(".left");
        const rightBtn = document.querySelector(".right");

        if (!carousel || !leftBtn || !rightBtn) return; // safety check

        leftBtn.onclick = () =>
            carousel.scrollBy({ left: -300, behavior: "smooth" });
        rightBtn.onclick = () =>
            carousel.scrollBy({ left: 300, behavior: "smooth" });
    });
</script>

<style>
    .carousel {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        gap: 1rem;
        padding: 1rem;
        background: rgba(186, 58, 153, 0.4); /* deep pink/purple tint */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        /* Shadow & rounded corners for depth */
        box-shadow:
            0 4px 15px rgba(0, 0, 0, 0.15),
            0 10px 30px rgba(0, 0, 0, 0.2);
        /* border-radius: 15px; */
        padding: 1rem;
        overflow-x: auto; /* allow horizontal scroll */
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch; /* smooth momentum on iOS/mac */
        /* cursor: grab; optional visual hint */
        scroll-behavior: smooth;
    }

    .carousel-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(63, 27, 68, 0.4); /* soft orange */
        border: none;
        font-size: 2rem;
        cursor: pointer;
        padding: 0.5rem 0.8rem;
        border-radius: 50%;
        backdrop-filter: blur(6px);
        box-shadow: 0 0 15px rgba(91, 46, 98, 0.6);
        transition: all 0.3s ease;
        opacity: 0; /* hidden until hover */
    }

    .arrow.left {
        left: 10px;
    }
    .arrow.right {
        right: 10px;
    }

    /* Hover glow effect */
    .carousel-wrapper:hover .arrow {
        opacity: 1;
    }

    .arrow:hover {
        transform: translateY(-50%) scale(1.2);
        box-shadow: 0 0 25px rgba(59, 19, 59, 0.8);
        background: rgba(55, 18, 44, 0.6);
    }

    .carousel::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .carousel-item {
        flex: 0 0 auto;
        width: 100%;
        max-width: 600px;
        /* want to be centered on each photo when its past a certain breakpoint */
        scroll-snap-align: center;
    }

    .carousel-item img {
        width: 100%;
        height: auto;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        object-position: center;
    }

    .carousel:hover img {
        transition: transform 0.4s ease;
        transform: scale(1.01);
    }
</style>
