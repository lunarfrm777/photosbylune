---
import PhotoCard from "../components/PhotoCard.astro";

const photos = [
  { src: "/fulls/01.jpg", alt: "Full Moon" },
  { src: "/fulls/02.jpg", alt: "Sunrise" },
  { src: "/fulls/03.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/04.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/05.jpg", alt: "Snowy mountain pea" },
  { src: "/fulls/06.jpg", alt: "Cutie cows grazing" },
  { src: "/fulls/07.jpg", alt: "Cutie cows grazing" },
  { src: "/fulls/08.jpg", alt: "Bright tree in the winter" },
  {
    src: "/fulls/09.jpg",
    alt: "Jimmie Simpson park in the winter, bench focus",
  },
  { src: "/fulls/10.jpg", alt: "CN Tower close up" },
  { src: "/fulls/11.jpg", alt: "TTC streetcar lights through snowfall" },
  { src: "/fulls/12.jpg", alt: "TTC streetcar during snowfall" },
];
---

<div class="gallery grid grid-cols-3 gap-4">
  {photos.map((src) => <PhotoCard src={src} alt="Photo" />)}
</div>

<div class="container">
  {photos.map((photo) => <PhotoCard {...photo} />)}
</div>

<footer>
  <p>© 2026 Your Name</p>
</footer>

<style>
  img {
    border: 0.2rem black solid;
    border-radius: 1rem;
  }

  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
    background-color: aquamarine;
  }
  .grid-gallery img {
    width: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .grid-gallery img:hover {
    transform: scale(1.05);
  }
  /* section {
      padding: 4rem 2rem;
    } */

  .about-contact-wrapper {
    background-color: rgb(131, 255, 255);
    display: flex;
    justify-content: center; /* horizontal center */
    align-items: center; /* vertical center */
    height: 100vh; /* full viewport height */
  }

  .about-contact {
    display: grid;
    grid-template-columns: 1fr 1fr; /* split screen inside */
    width: 80vw; /* 80% of viewport width */
    max-width: 1200px; /* optional max width */
    height: 60vh; /* content height */
    gap: 2rem;
    background-color: #ce53f7;
    padding: 2rem;
    border-radius: 10px;
  }
  footer {
    grid-column: 1 / -1; /* span both columns */
    text-align: center;
    padding: 1rem;
    background-color: #111;
    color: white;
  }

  /* Responsive: stack on smaller screens */
  @media (max-width: 768px) {
    .about-contact {
      grid-template-columns: 1fr; /* single column */
      gap: 1.5rem;
    }
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  button {
    background: #f97316;
    color: white;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  button:hover {
    background: #fb923c;
  }
</style>
