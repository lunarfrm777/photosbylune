---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
---

--- // Photographer.astro ---
<header class="nav">
  <h1>Lune's Photos</h1>
  <nav>
    <a href="#portfolio">Portfolio</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section id="hero" class="hero">
  <h2>Moments</h2>
</section>

<section id="portfolio" class="grid-gallery">
  <img src="/images/photo1.jpg" alt="Photo 1" />
  <img src="/images/photo2.jpg" alt="Photo 2" />
  <img src="/images/photo3.jpg" alt="Photo 3" />
</section>

<section id="about">
  <h2>About Me</h2>
  <p>I’m a photographer passionate about capturing life’s beautiful moments.</p>
</section>

<section id="contact">
  <h2>Contact Me</h2>
  <form>
    <input type="text" placeholder="Name" />
    <input type="email" placeholder="Email" />
    <textarea placeholder="Message"></textarea>
    <button>Send</button>
  </form>
</section>

<footer>
  <p>© 2026 Your Name</p>
  <div class="socials">
    <a href="#">Instagram</a>
    <a href="#">Twitter</a>
  </div>
</footer>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: #111;
    color: white;
  }
  .hero {
    height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: url("/images/hero.jpg") center/cover no-repeat;
    color: white;
    font-size: 3rem;
  }
  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
  }
  .grid-gallery img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .grid-gallery img:hover {
    transform: scale(1.05);
  }
  section {
    padding: 4rem 2rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  button {
    background: #f97316;
    color: white;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  button:hover {
    background: #fb923c;
  }
</style>
