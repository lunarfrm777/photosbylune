---
import PhotoCard from "../components/PhotoCard.astro";

const photos = [
  { src: "/fulls/01.jpg", alt: "Full Moon" },
  { src: "/fulls/02.jpg", alt: "Sunrise" },
  { src: "/fulls/03.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/04.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/05.jpg", alt: "Snowy mountain pea" },
  { src: "/fulls/06.jpg", alt: "Cutie cows grazing" },
  { src: "/fulls/07.jpg", alt: "Cutie cows grazing" },
  { src: "/fulls/08.jpg", alt: "Bright tree in the winter" },
  {
    src: "/fulls/09.jpg",
    alt: "Jimmie Simpson park in the winter, bench focus",
  },
  { src: "/fulls/10.jpg", alt: "CN Tower close up" },
  { src: "/fulls/11.jpg", alt: "TTC streetcar lights through snowfall" },
  { src: "/fulls/12.jpg", alt: "TTC streetcar during snowfall" },
];
---

<div class="grid-gallery">
  {photos.map((photo) => <PhotoCard {...photo} />)}
</div>

<style>
  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
    background-color: aquamarine;
  }
</style>
