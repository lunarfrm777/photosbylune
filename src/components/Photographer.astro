---

---

<header class="main-header">
  <h1>♡ Photos by Lune ♡</h1>
  <nav class="container">
    <ul>
      <li><a href="#portfolio">Portfolio</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<section id="hero" class="hero">
  <h2>Moments</h2>
</section>

<!-- update alt text-->
<section id="portfolio" class="grid-gallery">
  <img src="/fulls/01.jpg" alt="Moon Photo" />
  <img src="/fulls/02.jpg" alt="Photo 2" />
  <img src="/fulls/03.jpg" alt="Photo 3" />
  <img src="/fulls/04.jpg" alt="Photo 1" />
  <img src="/fulls/05.jpg" alt="Photo 1" />
  <img src="/fulls/06.jpg" alt="Photo 2" />
  <img src="/fulls/07.jpg" alt="Photo 3" />
  <img src="/fulls/08.jpg" alt="Photo 1" />
  <img src="/fulls/09.jpg" alt="Photo 2" />
  <img src="/fulls/10.jpg" alt="Photo 3" />

  <section id="about">
    <h2>About Me</h2>
    <p>
      I’m a photographer passionate about capturing life’s beautiful moments.
    </p>
  </section>

  <section id="contact">
    <h2>Contact Me</h2>
    <form>
      <input type="text" placeholder="Name" />
      <input type="email" placeholder="Email" />
      <textarea placeholder="Message"></textarea>
      <button>Send</button>
    </form>
  </section>

  <footer>
    <p>© 2026 Your Name</p>
    <div class="socials">
      <a href="#">Instagram</a>
      <a href="#">Twitter</a>
    </div>
  </footer>

  <style>
    h1 {
      color: black;
    }
    .main-header {
      display: flex;
      justify-content: space-between;
      padding: 1rem 2rem;
      background: #ffa9e5f4;
      color: white;
    }

    nav.container {
      display: flex; /* turn nav into flex container */
      justify-content: center; /* center the items horizontally */
      align-items: center; /* vertically center items */
      padding: 1rem 2rem;
      background-color: #111;
    }

    .hero {
      height: 80vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #ce53f7;
      color: rgb(7, 7, 7);
      font-size: 3rem;
    }
    .grid-gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      padding: 2rem;
    }
    .grid-gallery img {
      width: 100%;
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.3s;
    }
    .grid-gallery img:hover {
      transform: scale(1.05);
    }
    section {
      padding: 4rem 2rem;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    button {
      background: #f97316;
      color: white;
      padding: 0.75rem 1.5rem;
      cursor: pointer;
      transition: background 0.3s;
    }
    button:hover {
      background: #fb923c;
    }
  </style>
</section>
