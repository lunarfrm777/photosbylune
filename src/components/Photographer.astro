---
import PhotoCard from "../components/PhotoCard.astro";

const photos = [
  { src: "/fulls/01.jpg", alt: "Moon over the lake at night" },
  { src: "/fulls/02.jpg", alt: "Sunrise over mountains" },
  { src: "/fulls/03.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/04.jpg", alt: "Moon over the lake at night" },
  { src: "/fulls/05.jpg", alt: "Sunrise over mountains" },
  { src: "/fulls/06.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/07.jpg", alt: "Moon over the lake at night" },
  { src: "/fulls/08.jpg", alt: "Sunrise over mountains" },
  { src: "/fulls/09.jpg", alt: "Snowy mountain peak" },
  { src: "/fulls/10.jpg", alt: "Moon over the lake at night" },
  { src: "/fulls/11.jpg", alt: "Sunrise over mountains" },
  { src: "/fulls/12.jpg", alt: "Snowy mountain peak" },
];
---

<div class="gallery grid grid-cols-3 gap-4">
  {photos.map((src) => <PhotoCard src={src} alt="Photo" />)}
</div>

<div class="container">
  {photos.map((photo) => <PhotoCard {...photo} />)}
</div>

<div class="about-contact-wrapper">
  <section id="about" class="about-contact">
    <div class="content">
      <div class="about">
        <h2>About Me</h2>
        <p>
          I’m a photographer passionate about capturing life’s beautiful
          moments.
        </p>
      </div>

      <div id="contact" class="contact">
        <h2>Contact Me</h2>
        <form>
          <input type="text" placeholder="Name" />
          <input type="email" placeholder="Email" />
          <textarea placeholder="Message"></textarea>
          <button>Send</button>
        </form>
      </div>
    </div>
  </section>
</div>

<footer>
  <p>© 2026 Your Name</p>
</footer>

<style>
  h1 {
    color: black;
  }
  .main-header {
    display: flex;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: #ffa9e5f4;
    color: white;
  }

  nav.container {
    display: flex; /* turn nav into flex container */
    justify-content: center; /* center the items horizontally */
    align-items: center; /* vertically center items */
    padding: 1rem 2rem;
  }

  nav.container ul {
    display: flex; /* make the list items line up in a row */
    gap: 2rem; /* spacing between links */
    list-style: none; /* remove bullets */
    margin: 0; /* remove default ul margin */
    padding: 0; /* remove default ul padding */
  }

  a {
    text-decoration: none;
  }

  img {
    border: 0.2rem black solid;
    border-radius: 1rem;
  }
  .hero {
    height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #63f753;
    color: rgb(7, 7, 7);
    font-size: 3rem;
  }
  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
    background-color: aquamarine;
  }
  .grid-gallery img {
    width: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .grid-gallery img:hover {
    transform: scale(1.05);
  }
  /* section {
      padding: 4rem 2rem;
    } */

  .about-contact-wrapper {
    background-color: rgb(131, 255, 255);
    display: flex;
    justify-content: center; /* horizontal center */
    align-items: center; /* vertical center */
    height: 100vh; /* full viewport height */
  }

  .about-contact {
    display: grid;
    grid-template-columns: 1fr 1fr; /* split screen inside */
    width: 80vw; /* 80% of viewport width */
    max-width: 1200px; /* optional max width */
    height: 60vh; /* content height */
    gap: 2rem;
    background-color: #ce53f7;
    padding: 2rem;
    border-radius: 10px;
  }
  footer {
    grid-column: 1 / -1; /* span both columns */
    text-align: center;
    padding: 1rem;
    background-color: #111;
    color: white;
  }

  /* Responsive: stack on smaller screens */
  @media (max-width: 768px) {
    .about-contact {
      grid-template-columns: 1fr; /* single column */
      gap: 1.5rem;
    }
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  button {
    background: #f97316;
    color: white;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  button:hover {
    background: #fb923c;
  }
</style>
