<footer>
    <nav class="footer-links-container" aria-label="navigation">
        <ul>
            <a href="/">
                <li><p>© Photos by Lune</p></li>
            </a>

            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#about">About</a></li>
            <li>
                <a
                    href="https://github.com/lunarfrm777"
                    aria-label="github profile of lune"
                    ><i class="fa-brands fa-github-alt"></i></a
                >
            </li>
            <li>
                <a
                    href="https://linkedin.com/in/lunem"
                    aria-label="twitter profile of lune"
                    ><i class="fa-brands fa-linkedin"></i></a
                >
            </li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</footer>

<style>
    .footer-links-container {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    /* nav links horizontal list */
    .footer-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* individual link style + hover underline */
    .footer-links a {
        position: relative;
        text-decoration: none;
        font-weight: bold;
        color: #f36282;
        transition: color 0.3s ease;
    }

    .footer-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: rgb(255, 120, 235);
        transition: width 0.3s ease;
    }

    .footer-links a:hover {
        color: #e3eb00;
    }

    .footer-links a:hover::after {
        width: 100%;
    }

    /* responsive: stack links under 768px */
    @media (max-width: 768px) {
        .footer-links {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>
