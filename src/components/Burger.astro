<!-- burger / mobile links -->
<div class="nav-wrapper">
    <div class="burger">
        <input type="checkbox" id="check" />
        <label for="check" class="checkbtn"
            ><i class="fa-solid fa-burger"></i></label
        >
    </div>
    <ul class="nav-mobile">
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</div>
<style>
    .burger {
        display: none;
        position: relative;
    }

    #check {
        display: none;
    }

    .checkbtn {
        display: none;
        font-size: 2rem;
        cursor: pointer;
        color: white;
    }

    /* menu */
    .nav-mobile {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100vw;
        background: #46124b;
    }

    /* toggle works because SAME component */
    #check:checked ~ .nav-mobile {
        display: block;
    }

    /* MOBILE */
    @media screen and (max-width: 625px) {
        .burger {
            display: block;
        }

        :global(.nav-links-container) {
            display: none;
        }

        .checkbtn {
            display: block;
        }
    }
</style>
